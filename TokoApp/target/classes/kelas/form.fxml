<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController">
    <top>
        <HBox prefHeight="113.0" prefWidth="589.0" spacing="16" styleClass="header">
            <Label styleClass="title" text="Admin Warkop Hijau Makmur" />
            <Button onAction="#bukaDaftar" prefHeight="41.0" prefWidth="162.0" text="Lihat Daftar Menu" textAlignment="CENTER">
            <font>
               <Font name="System Bold" size="15.0" />
            </font></Button>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="12" styleClass="card">
                        <Label styleClass="subtitle" text="Tambah Menu Baru" />
                        <Label text="Nama Menu" />
                        <TextField fx:id="namaField" promptText="Contoh: Nasi Goreng" />
                        <Label text="Jenis Kategori" />
                        <ComboBox fx:id="kategoriBox" maxWidth="Infinity" />
                        <Label text="Harga (Rp)" />
                        <TextField fx:id="hargaField" promptText="Contoh: 15000" />
                        <Button maxWidth="Infinity" onAction="#simpan" styleClass="button-primary" text="Simpan Menu" textFill="WHITE" />
                        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
